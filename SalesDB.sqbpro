<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SalesDB.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2986"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Customers" custom_title="0" dock_id="1" table="4,9:mainCustomers"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1">-- 6.10. Create one two-period sales register (UNION ALL)
SELECT 'October 2026' AS PeriodLabel, o.OrderID, o.OrderDate, c.CustomerID, 
       c.FirstName || ' ' || c.LastName AS CustomerName, 
       e.FirstName || ' ' || e.LastName AS EmployeeName, o.Sales
FROM Orders o
INNER JOIN Customers c ON o.CustomerID = c.CustomerID
INNER JOIN Employees e ON o.SalesPersonID = e.EmployeeID
WHERE o.OrderStatus IN ('Shipped', 'Delivered') AND o.ShipDate IS NOT NULL AND o.ShipDate &gt;= o.OrderDate
  AND o.OrderDate BETWEEN '2026-10-01' AND '2026-10-31'
UNION ALL
SELECT 'November 01-07' AS PeriodLabel, o.OrderID, o.OrderDate, c.CustomerID, 
       c.FirstName || ' ' || c.LastName AS CustomerName, 
       e.FirstName || ' ' || e.LastName AS EmployeeName, o.Sales
FROM Orders o
INNER JOIN Customers c ON o.CustomerID = c.CustomerID
INNER JOIN Employees e ON o.SalesPersonID = e.EmployeeID
WHERE o.OrderStatus IN ('Shipped', 'Delivered') AND o.ShipDate IS NOT NULL AND o.ShipDate &gt;= o.OrderDate
  AND o.OrderDate BETWEEN '2026-11-01' AND '2026-11-07'
ORDER BY OrderDate ASC, OrderID ASC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
